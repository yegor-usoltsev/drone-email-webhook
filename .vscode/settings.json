{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "emmet.showExpandedAbbreviation": "never",
  "files.readonlyInclude": {
    "**/bun.lock": true,
    "**/email.html": true,
    "**/node_modules/**": true,
    "**/out/**": true
  },
  "js/ts.tsdk.path": "email-template/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "oxc.configPath": "email-template/oxlint.config.ts",
  "oxc.fmt.configPath": "email-template/oxfmt.config.ts",
  "oxc.tsConfigPath": "email-template/tsconfig.json",
  "typescript.tsdk": "email-template/node_modules/typescript/lib",
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
