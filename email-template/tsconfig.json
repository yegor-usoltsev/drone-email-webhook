{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["bun"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules"]
}
